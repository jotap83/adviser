      "css": ".ds-field{font-family:\"DM Sans\",sans-serif;display:flex;flex-direction:column;gap:6px;margin-bottom:18px;min-width:0;color:#233149;font-size:14px;line-height:1.5;}.ds-field>span{font-size:12px;font-weight:600;color:#465773;}.ds-field>small{font-size:11px;color:var(--muted,#62718a);}.ds-field input{font:inherit;border:1px solid #cbd4e1;border-radius:7px;padding:10px 12px;color:#233149;background:#fff;min-width:0;max-width:100%;min-height:41px;transition:border-color .15s;caret-color:var(--blue,#245edb);}.ds-field input::placeholder{color:#596d89;}.ds-field input:focus{border-color:var(--blue,#245edb);}.ds-field input:focus-visible{outline:3px solid #8cb5ff;outline-offset:3px;}.ds-field input:disabled{background:#f4f6f9;}@media(max-width:760px){.ds-field input{font-size:16px;}}@media(prefers-reduced-motion:reduce){.ds-field input{transition:none;}}"

      "html": "<div class=\"ds-badges\"><span class=\"ds-badge\">Demonstração</span><span class=\"ds-badge ds-badge-blue\">Briefing</span><span class=\"ds-badge ds-badge-green\">Aprovada</span><span class=\"ds-badge ds-badge-amber\">Aguardando</span><span class=\"ds-badge ds-badge-red\">Recusada</span></div>",
      "css": ".ds-badges{display:flex;flex-wrap:wrap;gap:10px;}.ds-badge{font-family:\"DM Sans\",sans-serif;display:inline-flex;gap:5px;align-items:center;border-radius:5px;background:#edf1f6;color:#526079;padding:4px 8px;white-space:nowrap;font-size:11px;font-weight:600;line-height:1.5;}.ds-badge-blue{background:#e9f0ff;color:#2455b3;}.ds-badge-green{background:#e7f3ed;color:#246346;}.ds-badge-amber{background:#fff2dd;color:#886017;}.ds-badge-red{background:#fcebea;color:#a03131;}"

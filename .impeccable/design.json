      "html": "<nav class=\"ds-nav\" aria-label=\"Navegação principal\"><span class=\"ds-nav-label\">ATENDIMENTO</span><a href=\"#/\" class=\"ds-nav-link\">Visão geral</a><a href=\"#/demandas\" class=\"ds-nav-link ds-nav-active\" aria-current=\"page\">Demandas</a><a href=\"#/fornecedores\" class=\"ds-nav-link\">Fornecedores</a></nav>",
      "css": ".ds-nav{font-family:\"DM Sans\",sans-serif;display:flex;flex-direction:column;padding:18px;background:var(--navy,#14243c);color:#fff;width:194px;}.ds-nav-label{font-size:9px;letter-spacing:.12em;color:#92a5bf;margin:20px 14px 9px;font-weight:600;}.ds-nav-link{display:flex;align-items:center;gap:11px;padding:12px 13px;margin:2px 0;border-radius:7px;color:#becce0;text-decoration:none;font-size:12px;line-height:1.5;font-weight:500;min-height:44px;}.ds-nav-link:hover{background:#1e3452;color:#fff;}.ds-nav-link.ds-nav-active{background:#2c5ab7;color:#fff;}.ds-nav-link:focus-visible{outline:3px solid #8cb5ff;outline-offset:3px;}"

      "html": "<button class=\"ds-btn-primary\" type=\"button\">Validar briefing</button>",
      "css": ".ds-btn-primary{font-family:\"DM Sans\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid #d5dce7;background:#fff;color:#36445b;min-height:40px;padding:9px 14px;border-radius:7px;font-weight:600;font-size:13px;line-height:1.4;transition:background-color .15s,border-color .15s;white-space:normal;cursor:pointer;background:var(--blue,#245edb);border-color:var(--blue,#245edb);color:#fff;}.ds-btn-primary:hover:not(:disabled){background:#174cb9;border-color:#b6c5db;}.ds-btn-primary:focus-visible{outline:3px solid #8cb5ff;outline-offset:3px;}.ds-btn-primary:disabled{cursor:not-allowed;opacity:.52;}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none;}}"
